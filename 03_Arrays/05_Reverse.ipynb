    "#two pointer\n",
    "\n",
    "arr  = [10,20,30,40,50]\n",
    "\n",
    "def reverse(arr):\n",
    "    left = 0\n",
    "    right = len(arr)-1\n",
    "    while left < right:\n",
    "        arr[left],arr[right] = arr[right],arr[left]\n",
    "        left += 1\n",
    "        right -= 1\n",
    "    return arr\n",
    "\n",
    "print(reverse(arr))"
   ]
  }
 ],
